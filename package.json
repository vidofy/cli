{
  "name": "@vidofy/cli",
  "version": "0.1.1",
  "description": "Generate AI video, images and voice from your terminal — Veo 3.1, Kling 3.0, Flux 2, Seedance 2.5, Wan 2.7, Hailuo 2.3 and 570+ models, billed to your own Vidofy account. Scriptable, pipeable, CI-ready.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "vidofy": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node test/contract.test.mjs",
    "prepublishOnly": "npm run build && node test/contract.test.mjs"
  },
  "dependencies": {
    "@vidofy/mcp": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "vidofy",
    "cli",
    "ai",
    "video-generation",
    "image-generation",
    "text-to-speech",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidofy/cli.git"
  },
  "homepage": "https://vidofy.ai/en/cli",
  "bugs": {
    "url": "https://github.com/vidofy/cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
